{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "Junshengxie"
  ],
  "contact": {
    "sources": "https://github.com/Hidoni/Transmog"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.hidoni.transmog.TransmogFabric"
    ],
    "client": [
      "com.hidoni.transmog.TransmogFabricClient"
    ],
    "modmenu": [
      "com.hidoni.transmog.config.ModMenuApiImpl"
    ]
  },
  "mixins": [
    "mixins.transmog.common.json",
    "mixins.transmog.fabric.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
  